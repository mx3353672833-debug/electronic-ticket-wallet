{
  "name": "electronic-ticket-wallet",
  "private": true,
  "version": "0.4.2",
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:release && tsc -b && vite build",
    "check:release": "node scripts/check-release.mjs",
    "lint": "oxlint",
    "test": "vitest run",
    "test:server": "node --test server/*.test.mjs",
    "test:routes": "python3 scripts/rail-itinerary-test.py",
    "build:server": "VITE_WALLET_REMOTE=1 npm run build -- --base=/tickets/ && node scripts/build-server.mjs",
    "test:watch": "vitest",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tmcw/togeojson": "^7.1.2",
    "dexie": "^4.4.6",
    "gcoord": "1.0.7",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "motion": "^13.4.0",
    "nodemailer": "10.0.10",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^24.13.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.0",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
